# Config for `docker compose up`, read from a `.env` file in this folder.
# Copy this to `.env` and fill in real values. `.env` is git-ignored.

# Household timezone. Every scheduling rule is computed here.
HOUSEHOLD_TZ=America/Chicago

# Password for the chore_quest role inside the existing "postgresql" ZimaOS
# app (container `postgresql`). Matches what was set when that role was
# created - see the comment at the top of docker-compose.yml.
CHOREQUEST_DB_PASSWORD=REPLACE_ME

# Signs sessions. Generate a fresh one:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=REPLACE_ME

# Folder on the ZimaOS HOST filesystem, on the external drive, where nightly
# backups mirror themselves. This box's Seagate Expansion drive:
EXTERNAL_BACKUP_PATH=/DATA/.media/sda2-usb-Seagate_Expansi/ChoreQuestBackups

# Optional. Web Push (npm run vapid -w backend prints all three) - leave all
# blank to run without phone notifications.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# Optional, only needed if you hit the API from a separate origin than the
# one serving the frontend.
CORS_ORIGINS=http://localhost:4000
