# Chore Quest backend configuration.
# Copy to backend/.env and fill in real values. Never commit backend/.env.
# Schema of record: backend/src/env.ts

# development | test | production
NODE_ENV=development

# Fastify bind. Keep HOST on loopback unless you intend to serve the house LAN.
PORT=4000
HOST=127.0.0.1

# IANA zone. Every scheduling rule is computed here, never a fixed UTC offset.
HOUSEHOLD_TZ=America/Chicago

# Comma-separated list of allowed browser origins.
CORS_ORIGINS=http://localhost:5173

# PostgreSQL connection string. Required from Stage 3 onward.
DATABASE_URL=postgres://chore_quest:REPLACE_ME@127.0.0.1:5432/chore_quest

# Random secret used to sign sessions. Generate a fresh one per machine:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=REPLACE_ME

# Web Push (VAPID). Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:parent@example.com

# Local storage paths, relative to the backend workspace.
PHOTO_STORAGE_DIR=./storage/photos
BACKUP_DIR=./storage/backups

# Optional second copy on a removable drive, e.g. E:\ChoreQuestBackups.
# Left unset, or the drive unplugged, means backups exist only on this laptop -
# which protects against mistakes but not against losing the machine.
BACKUP_MIRROR_DIR=

# Where pg_dump and pg_restore live. Normally found without help. Needed only if
# PostgreSQL is somewhere unusual - it is looked up by absolute path rather than
# on PATH, because a scheduled task does not have the PATH of whoever installed
# it, and a backup that fails for that reason fails silently.
PG_BIN_DIR=

# --- Serving the household over https on the home wifi (Stage 16) ---
#
# Nothing here is exposed to the internet. PUBLIC_HOSTNAME is a real name with a
# real certificate, but its DNS record points at this laptop's private address,
# so it resolves on your wifi and nowhere else. That is what lets the kids'
# phones use the camera and receive notifications, neither of which a browser
# allows over plain http.
#
# Leave all of this unset and the app runs on plain http exactly as before.

# The name the phones will use, e.g. chores.example.com
PUBLIC_HOSTNAME=

# Where the certificate and its key are kept. Setting this also marks the
# session cookie Secure.
TLS_DIR=./storage/tls
HTTPS_PORT=443

# The built frontend, served from the same origin as the API so the session
# cookie is first-party. Safari on iOS blocks third-party cookies outright.
FRONTEND_DIST=../frontend/dist

# Automatic renewal. A certificate lasts 90 days, so this cannot be something
# anybody remembers. DNS-01 challenge, because the usual one needs this laptop
# reachable from the internet - the one thing being avoided.
# The token needs Zone:DNS:Edit on this zone only.
ACME_EMAIL=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=
# Let's Encrypt staging while setting up, so failed attempts do not count
# against the weekly limit for the domain.
ACME_STAGING=false
