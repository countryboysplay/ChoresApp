# Chore Quest frontend configuration.
# Copy to frontend/.env.local. Never commit that file.
#
# WARNING: every VITE_ variable is compiled into the browser bundle and is
# public by definition. Never put a secret here.

# Base URL of the backend API.
#
# Copy this to frontend/.env.development.local, NOT frontend/.env.local. Vite
# loads .env.local in every mode including a production build, so a value there
# is compiled into the bundle the household actually runs - which pins the app
# to localhost and breaks it on every phone.
#
# A production build needs nothing here at all: it defaults to its own origin,
# because the backend serves the frontend so the session cookie is first-party.
VITE_API_BASE_URL=http://localhost:4000
